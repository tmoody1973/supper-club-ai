# Server-only provider credentials. Never prefix these with NEXT_PUBLIC_.
SPOONACULAR_API_KEY=
GRAPEMINDS_API_KEY=
APPLE_MUSIC_DEVELOPER_TOKEN=
DISCOGS_TOKEN=
DISCOGS_USER_AGENT=SupperClubAI/0.1
PERPLEXITY_API_KEY=
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# Optional shared secret for server-to-server PlanStore calls from chatgpt-app.
SUPPER_CLUB_SERVICE_TOKEN=

# Durable anonymous plan storage. Configure both values in production.
# Without them, local development uses the 24-hour in-memory fallback.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
