  "cards": [
    {
      "dot": "cyan",
      "title": "Every WebMCP call has two visible outcomes",
      "items": [
        "The website updates the shared plan so the host sees cards, progress, and choices.",
        "The tool returns structured JSON so ChatGPT can explain the result and choose the next action."
      ]
    },
    {
      "dot": "emerald",
      "title": "Trust and reliability",
      "items": [
        "API keys remain behind Next.js server routes; external responses are normalized before use.",
        "Saving an Apple Music playlist or finalizing a plan can require explicit host confirmation."
      ]
    }
  ]
